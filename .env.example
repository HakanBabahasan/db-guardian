# ── Production DB ──────────────────────────────────────────
PROD_DB_HOST=prod_db
PROD_DB_PORT=5432
PROD_DB_NAME=guardian_prod
PROD_DB_USER=guardian
PROD_DB_PASSWORD=guardian_secret

# ── Clone DB ────────────────────────────────────────────────
CLONE_DB_HOST=clone_db
CLONE_DB_PORT=5432
CLONE_DB_NAME=guardian_clone
CLONE_DB_USER=guardian
CLONE_DB_PASSWORD=guardian_secret

# ── Guardian Uygulama DB (audit log, kullanıcılar) ──────────
APP_DB_HOST=app_db
APP_DB_PORT=5432
APP_DB_NAME=guardian_app
APP_DB_USER=guardian
APP_DB_PASSWORD=guardian_secret

# ── JWT ─────────────────────────────────────────────────────
JWT_SECRET_KEY=change-this-super-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── Break-Glass ─────────────────────────────────────────────
BREAKGLASS_SECRET_KEY=change-this-breakglass-secret-in-production
BREAKGLASS_TIMEOUT_SECONDS=900        # 15 dakika
MAINTENANCE_MAX_HOURS=24              # Maks bekleme süresi

# ── Backup ──────────────────────────────────────────────────
BACKUP_DIR=/backups
BACKUP_RETENTION_DAYS=7

# ── Sistem ──────────────────────────────────────────────────
APP_ENV=development                   # development | production
LOG_LEVEL=INFO

# ── Bildirimler (opsiyonel) ──────────────────────────────────
# Slack webhook URL boş bırakılırsa Slack bildirimleri devre dışı
SLACK_WEBHOOK_URL=

# SMTP ayarları boş bırakılırsa e-posta bildirimleri devre dışı
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASSWORD=yourpassword
SMTP_FROM=guardian@yourcompany.com
SMTP_TO=admin@yourcompany.com

# ── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=10             # /api/execute başına dakikalık istek limiti

# ── CORS ─────────────────────────────────────────────────────
# Production'da virgülle ayrılmış whitelist. Boş bırakılırsa "*" kullanılır.
# Örn: ALLOWED_ORIGINS=https://guardian.company.com,https://admin.company.com
ALLOWED_ORIGINS=http://localhost:3000
